# Sazvar static site — caching rules.
# Images/CSS/JS/fonts are cached for a year; HTML is always revalidated so
# page edits go live immediately. style.css, main.js and stack-scroll.js are
# all loaded with a "?v=" query string in the HTML (see index.html etc.) —
# bump that number whenever the file changes, so the long cache below never
# serves a stale stylesheet or script. The same applies to any IMAGE that
# gets edited in place under the same filename (e.g. delivery-truck.png) —
# add/bump its own "?v=" too, or the 1-year immutable cache below will keep
# serving the old picture forever.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|svg|webp|ico|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers. HSTS is deliberately left without includeSubDomains,
  # so any subdomain that isn't on HTTPS yet keeps working.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Branded "page not found" page. Uses root-relative links so it works at any depth.
ErrorDocument 404 /404.html

# Keep internal files off the public web. They stay in the repo for editing,
# but the server answers 404 as if they didn't exist. contact.php still loads
# lib/phpmailer from disk, so blocking web access to lib/ doesn't affect it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [R=404,L]
  RewriteRule ^(IMAGES|lib|Brand[\s]Identity)(/|$) - [R=404,L]
  RewriteRule \.md$ - [R=404,L]
  RewriteRule ^(hero-preview\.html|smtp-config(\.sample)?\.php|\.gitignore|\.htaccess)$ - [R=404,L]
</IfModule>
